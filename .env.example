# ---------------------------------------------------------------------------
# Yavaya — local environment template. Copy to `.env` and fill in.
# Never commit a real `.env`. Never expose any of these to the browser.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=local
APP_URL=http://localhost:3000

# Database ------------------------------------------------------------------
DATABASE_URL=postgres://yavaya:yavaya@127.0.0.1:5432/yavaya_dev
DATABASE_POOL_MAX=10

# Secrets -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-at-least-32-random-characters-000000
SIGNAL_PEPPER=replace-me-with-at-least-32-random-characters-111111

# Private preview -----------------------------------------------------------
# When set, every route except /api/health requires this key (?key=… once, then
# a cookie) and responses carry noindex. Use it while email delivery is
# unconfigured, so nobody registers and gets stranded without a code.
# It is a curtain, not a security boundary. Minimum 16 characters.
# PREVIEW_ACCESS_KEY=

# Administration ------------------------------------------------------------
# The bootstrap grants the `admin` role to this address server-side.
PRIMARY_ADMIN_EMAIL=Junoagattis@gmail.com

# ---------------------------------------------------------------------------
# Integrations. Leaving a provider `unconfigured` disables the capability and
# makes the application say so. It never falls back to a fake success.
# See docs/CONFIGURATION.md for what each one needs.
# ---------------------------------------------------------------------------

# Email delivery (verification codes, receipts)
EMAIL_PROVIDER=unconfigured
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM="Yavaya <no-reply@example.com>"

# SMS delivery (phone verification)
SMS_PROVIDER=unconfigured

# Payments — PayPal is the provider available today. Absent credentials mean
# token purchases and subscriptions report "payments unavailable".
# PAYPAL_ENV=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=

# Identity document verification. `manual` routes to the admin review queue.
KYC_PROVIDER=unconfigured

# User media storage. Unset means uploads are rejected rather than lost.
MEDIA_STORAGE_PROVIDER=unconfigured
# MEDIA_LOCAL_PATH=./.storage

# Coarse IP geolocation. Unset means location is chosen manually or via GPS.
GEOIP_PROVIDER=unconfigured
