{
  "name": "yavaya",
  "version": "0.1.0",
  "private": true,
  "description": "Yavaya — digital infrastructure for Central America. One identity, one reputation, multiple districts.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:scripts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed/index.ts",
    "db:reset": "tsx src/server/db/reset.ts",
    "build:scripts": "node scripts/build-release-scripts.mjs",
    "build:deploy": "npm run build && node scripts/assemble-deploy.mjs",
    "jobs": "tsx src/server/jobs/run.ts",
    "db:migrate:dist": "node dist/scripts/migrate.cjs",
    "db:seed:dist": "node dist/scripts/seed.cjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "next": "^15.5.4",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
