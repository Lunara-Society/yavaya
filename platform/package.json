{
  "name": "yavaya",
  "version": "0.1.0",
  "private": true,
  "description": "Yavaya \u2014 digital infrastructure for Central America. One identity, one reputation, multiple districts.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:scripts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/db/seed/index.ts",
    "db:reset": "tsx src/server/db/reset.ts",
    "build:scripts": "node scripts/build-release-scripts.mjs",
    "build:deploy": "npm run build && node scripts/assemble-deploy.mjs",
    "jobs": "tsx --conditions=react-server src/server/jobs/run.ts",
    "db:migrate:dist": "node dist/scripts/migrate.cjs",
    "db:seed:dist": "node dist/scripts/seed.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@elevenlabs/client": "1.27.0",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.11.2",
    "next": "^15.5.28",
    "nodemailer": "^10.1.7",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "source-map-js": "^1.2.2",
    "livekit-client": "2.22.3"
  }
}
