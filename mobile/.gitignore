# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Never commit store credentials (EAS keeps the keystore; the Play key lives in Expo)
*.keystore
google-service-account*.json
credentials.json

# Skia web runtime (copied from node_modules for the web check: cp node_modules/canvaskit-wasm/bin/full/canvaskit.wasm public/)
public/canvaskit.wasm
.env.eas-simulator
